[TEMPLATE]
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Security — Content Security Policy (CSP) Reporting
# =============================================================================
# CSP violation reports help detect attacks (XSS, data injection) and
# misconfigured policies before they cause production issues.
#
# Sentry CSP endpoint format:
#   https://o{ORG_ID}.ingest.sentry.io/api/{PROJECT_ID}/security/?sentry_key={PUBLIC_KEY}
#
# To find your exact URL:
#   1. Log in to sentry.io
#   2. Go to Project Settings → Security Headers → CSP
#   3. Copy the provided report-uri URL
#
# Legacy CSP Level 2 directive (universally supported):
CSP_REPORT_URI=
#
# Modern CSP Level 3 Reporting-Endpoints header.
# Set to the endpoint name defined in reporting_endpoints config, e.g. "csp-endpoint"
# CSP_REPORT_TO=csp-endpoint
#
# Override for report-only policy (when testing new policy changes):
# CSP_REPORT_ONLY_URI=
# CSP_REPORT_ONLY_TO=

# =============================================================================
# Sentry Error Tracking & Performance Monitoring
# =============================================================================
# Backend: Laravel SDK
# SENTRY_LARAVEL_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
#
# Frontend: @sentry/react SDK (via Vite)
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.25
VITE_APP_VERSION=1.0.0

# =============================================================================
# CSP Nonce / Feature Toggle
# =============================================================================
# CSP_ENABLED=true
# CSP_NONCE_ENABLED=true
# CSP_ENABLED_WHILE_HOT_RELOADING=false

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# When deploying to production, ensure:
#
# 1. APP_ENV=production
# 2. APP_DEBUG=false
# 3. APP_KEY is set (php artisan key:generate)
# 4. APP_URL is set to your production domain (https://ovoll.in)
# 5. SESSION_ENCRYPT=true (already default above)
# 6. SESSION_SECURE_COOKIE=true (already default above)
# 7. CSP_REPORT_URI is configured for monitoring
# 8. Run: php artisan config:cache
# 9. Run: php artisan route:cache
